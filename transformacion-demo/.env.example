# ============================================================
# CONFIGURACIÓN DEL SISTEMA OPI ACELERACIÓN
# Copia este archivo a .env.local y completa los valores
# ============================================================

# Clerk Authentication (Clase 3)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Logging Level (Clase 5)
REACT_APP_LOG_LEVEL=debug

# API Configuration
REACT_APP_API_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Mock Data Toggle
REACT_APP_USE_MOCK_DATA=true

# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env.local
# 2. Reemplaza YOUR_KEY_HERE con tu Clerk key real
# 3. npm install && npm run dev
# ============================================================
