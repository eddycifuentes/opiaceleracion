# ============================================================
# CONFIGURACIÓN DEL SISTEMA OPI ACELERACIÓN (demo frontend)
# Copia este archivo a .env.local y completa los valores
# App Vite: las variables expuestas al cliente deben llevar prefijo VITE_
# ============================================================

# Clerk Authentication — NO USADO EN ESTA VERSIÓN
# El login es simulado (acepta cualquier contraseña). Clerk quedó planeado
# pero no está implementado. Variable conservada solo como referencia futura.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Logging Level
VITE_LOG_LEVEL=debug

# API Configuration (backend del asistente IA)
VITE_API_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Mock Data Toggle
VITE_USE_MOCK_DATA=true

# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env.local
# 2. Ajusta los valores según tu entorno
# 3. npm install && npm run dev
# ============================================================
